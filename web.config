<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Redirect query string search params to clean URL -->
                <rule name="BlockSearchQueryString" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{QUERY_STRING}" pattern="^s=" />
                    </conditions>
                    <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="false" />
                </rule>

                <!-- Redirect www to non-www (canonical) -->
                <rule name="RedirectWwwToNonWww" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^www\.antikbilge\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://antikbilge.com/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Redirect /index to root -->
                <rule name="RemoveIndex" stopProcessing="true">
                    <match url="^index$" />
                    <action type="Redirect" url="/" redirectType="Permanent" />
                </rule>

                <!-- 301 Redirect: old Göbekli Tepe URL to new SEO-friendly URL -->
                <rule name="RedirectGobeklitepe" stopProcessing="true">
                    <match url="^articles/gobeklitepe-arkeolojik-kirilma$" />
                    <action type="Redirect" url="/articles/gobeklitepe-nedir" redirectType="Permanent" />
                </rule>

                <!-- 301 Redirect: old Olimpos URL to new SEO-friendly URL -->
                <rule name="RedirectOlimpos" stopProcessing="true">
                    <match url="^articles/olimpos-tanrilari-neden-degisir(?:\.html)?/?$" />
                    <action type="Redirect" url="/articles/olimpos-tanrilari" redirectType="Permanent" />
                </rule>

                <!-- Redirect root pages that were previously resolved relative to /articles/ -->
                <rule name="RedirectLegacyArticleRelativeIndex" stopProcessing="true">
                    <match url="^articles/(?:articles/)?index(?:\.html)?/?$" />
                    <action type="Redirect" url="/" redirectType="Permanent" />
                </rule>
                <rule name="RedirectLegacyArticleRelativeRootPages" stopProcessing="true">
                    <match url="^articles/(mitoloji|katilim|gizlilik-politikasi|turk-mitolojisi|yunan-mitolojisi|hakkimizda|tarih|kullanim-sartlari|misir-mitolojisi|mezopotamya-mitolojisi|sanat-tarihi|arkeoloji|cerez-politikasi|iletisim)(?:\.html)?/?$" />
                    <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Redirect malformed duplicate /articles/articles/ URLs -->
                <rule name="RedirectDuplicateArticleRootPages" stopProcessing="true">
                    <match url="^articles/articles/(mitoloji|katilim)(?:\.html)?/?$" />
                    <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
                </rule>
                <rule name="RedirectDuplicateGobeklitepe" stopProcessing="true">
                    <match url="^articles/articles/gobeklitepe-nedir(?:\.html)?/?$" />
                    <action type="Redirect" url="/articles/gobeklitepe-nedir" redirectType="Permanent" />
                </rule>
                <rule name="RedirectDuplicateOlimpos" stopProcessing="true">
                    <match url="^articles/articles/olimpos-tanrilari(?:\.html)?/?$" />
                    <action type="Redirect" url="/articles/olimpos-tanrilari" redirectType="Permanent" />
                </rule>

                <!-- Redirect incorrect Roman emperors article URL -->
                <rule name="RedirectRomanEmperorsIncorrectSlug" stopProcessing="true">
                    <match url="^articles/roma-imparatorlari-neden-bu-kadar-sik-olduruluyordu(?:\.html)?/?$" />
                    <action type="Redirect" url="/articles/roma-imparatorlari-neden-olduruluyordu" redirectType="Permanent" />
                </rule>

                <!-- Remove .html extension -->
                <rule name="RemoveHtmlExtension" stopProcessing="true">
                    <match url="^(.+)\.html$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Rewrite clean URLs to .html files -->
                <rule name="RewriteToHtml" stopProcessing="true">
                    <match url="^([^.]+)$" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>
            </rules>
        </rewrite>

        <!-- Custom error pages -->
        <httpErrors errorMode="Custom" existingResponse="Replace">
            <remove statusCode="404" />
            <error statusCode="404" path="/404.html" responseMode="File" />
        </httpErrors>

        <!-- Security headers -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
            </customHeaders>
        </httpProtocol>

        <!-- Enable compression -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- Cache static files -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <remove fileExtension=".ico" />
            <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>
    </system.webServer>
</configuration>
